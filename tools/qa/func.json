 {"name":"drive","js":"(function(){var ids=Object.keys(NAV.cams);var best=null;ids.forEach(function(id){var s=NAV.cams[id];if(s>NAV.s+500&&(!best||s<best))best=s});window._cs=best;window._s=Math.max(0,best-450);window._al=0;window._iv=setInterval(function(){_s+=15;var q=routePoint(_s);onFix(q.la,q.lo,5,null,null,Date.now());if($('alertBox').classList.contains('on'))_al++},1000);return 'camera at '+Math.round(best)})()"},
 {"wait":12000,"name":"F10 카메라 경고","js":"ok('카메라 다가가면 경고 표지',_al>0,'경고 '+_al+'초, 카메라까지 '+Math.round(_cs-NAV.s)+'m')"},
 {"name":"F11 진행","js":"ok('경로 진행',NAV.s>_cs-450,'s='+Math.round(NAV.s))"},
 {"name":"off","js":"(function(){clearInterval(_iv);window._R0=NAV.R;var q=routePoint(NAV.s);var p=move(q.la,q.lo,q.h+90,350);var n=0;window._iv=setInterval(function(){n++;p=move(p[0],p[1],q.h+90,12);onFix(p[0],p[1],5,null,null,Date.now())},1000);return 1})()"},
 {"wait":16000,"name":"F12 재탐색","js":"ok('경로 이탈 시 재탐색',NAV.R!==_R0,'바뀜='+(NAV.R!==_R0))"},
 {"name":"stop","js":"(function(){clearInterval(_iv);var q=routePoint(NAV.s+20);feed(q.la,q.lo);return 1})()"},
